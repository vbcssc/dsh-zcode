{
  "name": "dsh-zcode-mode",
  "version": "0.1.0",
  "private": true,
  "description": "ZCode 模式 — 不改 DeepSeek Harness 源码，以一个外部 bundle 补齐 ZCode 有而 dsh 出厂没有的层：身份与行为约束 persona、处境注入（工作目录 / git 快照 / 日期）、具名子代理，以及在 turn 边界对“改了文件却没有成功验证”的硬校验。",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./situation": "./src/situation.js",
    "./verification-guard": "./src/verification-guard.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "text",
    "cordis.patch.yml",
    "INSTALL.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "preset": "node scripts/make-preset.mjs",
    "doctor": "node scripts/doctor.mjs",
    "unit": "node scripts/unit-situation.mjs",
    "unit:guard": "node scripts/unit-guard.mjs",
    "e2e:guard": "node scripts/e2e-guard.mjs",
    "verify": "node scripts/verify-mount.mjs"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent-preset": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-persona": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-subagent": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "zod": "^4.4.3"
  }
}
